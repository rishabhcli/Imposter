    "Generated word was too close to the prompt or a recent round. Using a pack word." : {
      "comment" : "Status banner shown when an AI-generated custom word is rejected for being too similar to the prompt or recent history.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das generierte Wort war dem Thema oder einer früheren Runde zu ähnlich. Es wird ein Wort aus dem Paket verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La palabra generada se parecía demasiado al tema o a una ronda reciente. Se usará una palabra del paquete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot généré était trop proche du thème ou d'une manche récente. Un mot du pack sera utilisé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成された単語がテーマまたは最近のラウンドに近すぎました。パックの単語を使用します。"
          }
        }
      }
    },
